  kind: "basic",
  name: "BasicOracleFlow",
  step: [
    {
      i: {
        ref: "oracle_ref01",
        srcdatavar: "oracle_ref01_data",
        suffix: "_dt0"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",

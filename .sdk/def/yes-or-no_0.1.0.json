{
  "openapi": "3.0.3",
  "info": {
    "title": "Yes or No API",
    "version": "1.0.0",
    "description": "Random yes/no/maybe answers in themed oracle voices from yesnooracle.app. Knowledge source: the documentation page https://yesnooracle.app/api and live GET probes on 2026-10-23 (every tool, the force parameter, and an invalid tool). Corrections to the docs from the probes: a maybe answer carries verdict 'again', not 'maybe'; the server also accepts the undocumented tool 'wheel'; an unknown tool returns HTTP 400 with an error message and the list of valid tools; an unknown force value is ignored. Answers are random, so any single call's word, phrase and answer will differ. The docs state a soft per-IP rate limit of about 60 requests per minute (not tested)."
  },
  "servers": [
    {
      "url": "https://yesnooracle.app"
    }
  ],
  "paths": {
    "/api/oracle": {
      "get": {
        "operationId": "getAnswer",
        "summary": "Get a random yes, no or maybe answer",
        "parameters": [
          {
            "name": "tool",
            "in": "query",
            "required": false,
            "description": "Themed answer pool. Omit for the general oracle. An unknown value returns 400.",
            "schema": {
              "type": "string",
              "enum": [
                "oracle",
                "magic-8-ball",
                "crystal-ball",
                "i-ching",
                "pendulum",
                "tarot",
                "runes",
                "wheel"
              ],
              "default": "oracle"
            },
            "example": "tarot"
          },
          {
            "name": "force",
            "in": "query",
            "required": false,
            "description": "Force the verdict, for tests and demos. Unknown values are ignored and the answer stays random.",
            "schema": {
              "type": "string",
              "enum": [
                "yes",
                "no",
                "maybe"
              ]
            },
            "example": "yes"
          }
        ],
        "responses": {
          "200": {
            "description": "A random answer.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Answer"
                }
              }
            }
          },
          "400": {
            "description": "Unknown tool.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Answer": {
        "type": "object",
        "required": [
          "answer",
          "verdict",
          "word",
          "phrase",
          "tool",
          "forced",
          "image"
        ],
        "properties": {
          "answer": {
            "type": "string",
            "description": "Normalized answer.",
            "enum": [
              "yes",
              "no",
              "maybe"
            ],
            "example": "yes"
          },
          "verdict": {
            "type": "string",
            "description": "Verdict label: 'yes' or 'no' matching answer, or 'again' when answer is 'maybe'.",
            "enum": [
              "yes",
              "no",
              "again"
            ],
            "example": "yes"
          },
          "word": {
            "type": "string",
            "description": "Themed headline, e.g. a tarot card or rune name.",
            "example": "The Emperor"
          },
          "phrase": {
            "type": "string",
            "description": "Themed reflective sentence.",
            "example": "The Emperor brings order and solid ground. Build on it with confidence — yes."
          },
          "tool": {
            "type": "string",
            "description": "The tool that answered.",
            "example": "tarot"
          },
          "forced": {
            "type": "boolean",
            "description": "True when the verdict was set with the force parameter."
          },
          "image": {
            "type": "string",
            "description": "URL of the tool's artwork.",
            "example": "https://yesnooracle.app/art-tarot.webp"
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "example": "Unknown tool \"bogus\"."
          },
          "validTools": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
